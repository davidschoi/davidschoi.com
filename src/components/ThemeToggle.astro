---
import './ThemeToggle.css';
---

<button class="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to dark theme">
  <svg class="theme-toggle__moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M13.6 9.6A5.7 5.7 0 0 1 6.4 2.4a5.7 5.7 0 1 0 7.2 7.2Z" />
  </svg>
  <svg class="theme-toggle__sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" aria-hidden="true">
    <circle cx="8" cy="8" r="3.1" />
    <path d="M8 1.3v1.6M8 13.1v1.6M14.7 8h-1.6M2.9 8H1.3M12.74 3.26l-1.13 1.13M4.39 11.61l-1.13 1.13M12.74 12.74l-1.13-1.13M4.39 4.39 3.26 3.26" />
  </svg>
</button>
